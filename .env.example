# Copy to .env.local (development) or set on your host (production).

# Required: password for /admin/. Use a long, unique value.
ADMIN_PASSWORD=

# Recommended: random string that signs admin sessions (falls back to ADMIN_PASSWORD).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Where the SQLite database and uploaded images live (default: ./data). Back this folder up.
# DATA_DIR=/home/clinic/data

# Optional: use a remote libSQL/Turso database instead of the local file.
# DATABASE_URL=libsql://your-db.turso.io
# DATABASE_AUTH_TOKEN=

# Optional: Google Calendar (see README → Google Calendar).
# The calendar's ID — for his main calendar, Dr. Ahmad's Gmail address.
# GOOGLE_CALENDAR_ID=
# The service account key: a path to the downloaded JSON file (keep it outside the project or in secrets/)...
# GOOGLE_SERVICE_ACCOUNT_FILE=/home/clinic/secrets/google-calendar.json
# ...or the file's contents on one line.
# GOOGLE_SERVICE_ACCOUNT_JSON=

# Clinic time zone for free times (default: Asia/Beirut) and default phone country code (961).
# CLINIC_TIMEZONE=Asia/Beirut
# DEFAULT_COUNTRY_CODE=961

# Existing options
# PRACTICE_PHONE=+96176937274
# PRACTICE_WHATSAPP=96176937274
# SITE_URL=https://example.com
# SITE_INDEXABLE=false
